        "schemaVersion",
        "status",
        "generatedAt",
        "release",
        "chain",
        "identities",
        "asset",
        "lifecycle",
        "supply",
        "schedule",
        "mining",
        "staking",
        "nft",
        "installationId"
      ],
      "additionalProperties": false
    },
    "d0_response": {
      "oneOf": [
        {
          "$ref": "#/$defs/d1_unavailable"
        },
        {
          "$ref": "#/$defs/d7_available"
        }
      ]
    }
  },
  "$comment": "Public response structure from source snapshot 2454d346d25e5b9dc48af7e547ce1038b6fdb5cc. See endpoint notes for semantic constraints."
}
