{
  "name": "squeekchain-analytics-ipfs",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Static community analytics and a clearly separate hamster rhythm game for IPFS.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate:validators": "tsx scripts/generate-validators.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:validators && npm run typecheck && vite build && node scripts/check-static.mjs",
    "test": "npm run generate:validators && tsx --test tests/*.test.ts",
    "preview": "node scripts/gateway-server.mjs",
    "check:sources": "tsx scripts/check-sources.ts",
    "pack:ipfs": "node scripts/package-static.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^0.468.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
